{
  "name": "dayswithoutall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p tests && vite build",
    "test": "vitest run",
    "preview": "npm run build && wrangler dev --env local --port 8799",
    "deploy": "npm run build && wrangler deploy",
    "shots": "node scripts/screenshots.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "og": "node scripts/og-images.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/three": "^0.187.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
